[gml_api]
module GMGooglePlayServices;

// Google Play Services API constants
// These represent limitations and constraints from the Google Play Games API
const PlayServicesMaxFriendsPageSize : int32 = 25;      // Maximum friends per page (API limit)
const PlayServicesMaxLeaderboardResults : int32 = 25;   // Maximum leaderboard results per page (API limit)
const PlayServicesMinPageSize : int32 = 1;              // Minimum page size

// Structured callback results are defined as GMIDL classes and automatically
// marshaled by the code generator into typed GML structs that callers receive
// as instances (e.g. new PlayServicesAuthResult(...)). This unifies the callback convention:
// every play_services_* callback receives a single typed result struct with success, data,
// and error fields, making the extension a transparent projection of the GMS API.

// Base
[global, bind = typed_gml]
function play_services_is_available(): bool;
[global, bind = typed_gml]
function play_services_sign_in(callback: func): unit;
[global, bind = typed_gml]
function play_services_is_authenticated(callback: func): unit;
[global, bind = typed_gml]
function play_services_request_server_side_access(server_client_id: string, force_refresh_token: bool, callback: func): unit;

// Player
[global, bind = typed_gml]
function play_services_player_current(callback: func): bool;
[global, bind = typed_gml]
function play_services_player_current_id(callback: func): bool;
[global, bind = typed_gml]
function play_services_player_stats_load(force_reload: bool, callback: func): bool;
[global, bind = typed_gml]
function play_services_player_load(player_id: string, force_reload: bool, callback: func): bool;
[global, bind = typed_gml]
function play_services_friends_load(force_reload: bool, max_results: real, callback: func): bool;
[global, bind = typed_gml]
function play_services_friends_load_more(page_size: real, callback: func): bool;
[global, bind = typed_gml]
function play_services_friends_load_with_consent(force_reload: bool, max_results: real, callback: func): bool;
[global, bind = typed_gml]
function play_services_player_profile_show(player_id: string): unit;
[global, bind = typed_gml]
function play_services_player_search_show(callback: func): bool;

// Achievements
[global, bind = typed_gml]
function play_services_achievements_show(): unit;
[global, bind = typed_gml]
function play_services_achievements_increment(achievement_id: string, steps: real, callback: func): unit;
[global, bind = typed_gml]
function play_services_achievements_reveal(achievement_id: string, callback: func): unit;
[global, bind = typed_gml]
function play_services_achievements_set_steps(achievement_id: string, steps: real, callback: func): unit;
[global, bind = typed_gml]
function play_services_achievements_unlock(achievement_id: string, callback: func): unit;
[global, bind = typed_gml]
function play_services_achievements_get_status(force_reload: bool, callback: func): unit;

// Leaderboards
[global, bind = typed_gml]
function play_services_leaderboard_show_all(): unit;
[global, bind = typed_gml]
function play_services_leaderboard_show(leaderboard_id: string): unit;
[global, bind = typed_gml]
function play_services_leaderboard_submit_score(leaderboard_id: string, score: real, score_tag: string, callback: func): unit;
[global, bind = typed_gml]
function play_services_leaderboard_load_player_centered_scores(leaderboard_id: string, [type_hint=`PlayServicesLeaderboardTimeSpan`] span, [type_hint=`PlayServicesLeaderboardCollection`] leaderboard_collection, max_results: real, force_reload: bool, callback: func): unit;
[global, bind = typed_gml]
function play_services_leaderboard_load_top_scores(leaderboard_id: string, [type_hint=`PlayServicesLeaderboardTimeSpan`] span, [type_hint=`PlayServicesLeaderboardCollection`] leaderboard_collection, max_results: real, force_reload: bool, callback: func): unit;

// URI helper
[global, bind = typed_gml]
function play_services_uri_to_path(uri: string, callback: func): unit;

// Saved Games
[global, bind = typed_gml]
function play_services_saved_games_show_saved_games_ui(title: string, button_add: bool, button_delete: bool, max_results: real, callback: func): unit;
[global, bind = typed_gml]
function play_services_saved_games_commit_and_close([type_hint=`PlayServicesSavedGameCommitOptions`] options: gmval, callback: func): unit;
[global, bind = typed_gml]
function play_services_saved_games_commit_new([type_hint=`PlayServicesSavedGameCommitOptions`] options: gmval, callback: func): unit;
[global, bind = typed_gml]
function play_services_saved_games_load(force_reload: bool, callback: func): unit;
[global, bind = typed_gml]
function play_services_saved_games_open(name: string, callback: func): unit;
[global, bind = typed_gml]
function play_services_saved_games_open_conflict(name: string, [type_hint=`PlayServicesSavedGamesConflictPolicy`] conflict_policy, callback: func): unit;
[global, bind = typed_gml]
function play_services_saved_games_delete(name: string, callback: func): unit;
[global, bind = typed_gml]
function play_services_saved_games_resolve_conflict(conflict_id: string, use_local: bool, callback: func): unit;

// Input class used by saved-game commit functions.
[global]
class `[[PlayServicesSavedGameCommitOptions]]` prototype Object
{
    [field] property name : string { get; set; }
    [field] property data : string { get; set; }
    [field] property desc : string { get; set; }
    [field] property played_time_millis : real { get; set; }
    [field] property progress_value : real { get; set; }
    [field] property cover_image_path : string { get; set; }
}

// Result classes for callback payloads.
[global, bind = typed_gml]
class `[[PlayServicesAuthResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field] property is_authenticated : bool { get; set; }
    [field] property error : string { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesPlayerInfo]]` prototype Object
{
    [field] property player_id : string { get; set; }
    [field] property display_name : string { get; set; }
    [field] property title : string { get; set; }
    [field] property icon_image_uri : string { get; set; }
    [field] property hi_res_image_uri : string { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesPlayer]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint=`PlayServicesPlayerInfo`] property player : gmval { get; set; }
    [field] property error : string { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesPlayerStats]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field] property average_session_length : real { get; set; }
    [field] property days_since_last_played : real { get; set; }
    [field] property number_of_purchases : real { get; set; }
    [field] property number_of_sessions : real { get; set; }
    [field] property session_percentile : real { get; set; }
    [field] property spend_percentile : real { get; set; }
    [field] property churn_probability : real { get; set; }
    [field] property high_spender_probability : real { get; set; }
    [field] property spend_probability : real { get; set; }
    [field] property total_spend_next_28_days : real { get; set; }
    [field] property error : string { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesPlayerList]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint=`PlayServicesPlayerInfo[]`] property players : gmval { get; set; }
    [field] property has_more : bool { get; set; }
    [field] property error : string { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesAchievement]]` prototype Object
{
    [field] property achievement_id : string { get; set; }
    [field] property name : string { get; set; }
    [field] property description : string { get; set; }
    [field] property state : real { get; set; }
    [field] property type : real { get; set; }
    [field] property current_steps : real { get; set; }
    [field] property total_steps : real { get; set; }
    [field] property last_updated_timestamp : real { get; set; }
    [field] property xp_value : real { get; set; }
    [field] property revealed_image_uri : string { get; set; }
    [field] property unlocked_image_uri : string { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesAchievementList]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field, type_hint=`PlayServicesAchievement[]`] property achievements : gmval { get; set; }
