[gml_api]
module GMGooglePlayServices;

// Google Play Services API constants
// These represent limitations and constraints from the Google Play Games API
const PLAY_SERVICES_MAX_FRIENDS_PAGE_SIZE : int32 = 25;      // Maximum friends per page (API limit)
const PLAY_SERVICES_MAX_LEADERBOARD_RESULTS : int32 = 25;    // Maximum leaderboard results per page (API limit)
const PLAY_SERVICES_MIN_PAGE_SIZE : int32 = 1;                // Minimum page size

// Every play_services_* callback follows the same shape: callback.call(status, data...).
// status is always the shared PlayServicesResult (success/error only); data is the real
// SDK payload as one or more further positional arguments - Optional<T> for a value that
// can be genuinely absent, a typed array for a collection, plus any further scalar - never
// bundled into a single per-function result struct.

// Base
[global, bind = typed_gml]
function play_services_is_available(): bool;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_sign_in(callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_is_authenticated(callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_request_server_side_access(server_client_id: string, force_refresh_token: bool, callback: func): gmval;

// Player
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_player_current(callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_player_current_id(callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_player_stats_load(force_reload: bool, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_player_load(player_id: string, force_reload: bool, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_friends_load(force_reload: bool, max_results: real, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_friends_load_more(page_size: real, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_friends_load_with_consent(force_reload: bool, max_results: real, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_player_profile_show(player_id: string): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_player_search_show(callback: func): gmval;

// Achievements
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_achievements_show(): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_achievements_increment(achievement_id: string, steps: real, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_achievements_reveal(achievement_id: string, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_achievements_set_steps(achievement_id: string, steps: real, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_achievements_unlock(achievement_id: string, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_achievements_get_status(force_reload: bool, callback: func): gmval;

// Leaderboards
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_leaderboard_show_all(): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_leaderboard_show(leaderboard_id: string): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_leaderboard_submit_score(leaderboard_id: string, score: real, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_leaderboard_submit_score_with_tag(leaderboard_id: string, score: real, score_tag: string, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_leaderboard_load_player_centered_scores(leaderboard_id: string, [type_hint=`PlayServicesLeaderboardTimeSpan`] span, [type_hint=`PlayServicesLeaderboardCollection`] leaderboard_collection, max_results: real, force_reload: bool, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_leaderboard_load_top_scores(leaderboard_id: string, [type_hint=`PlayServicesLeaderboardTimeSpan`] span, [type_hint=`PlayServicesLeaderboardCollection`] leaderboard_collection, max_results: real, force_reload: bool, callback: func): gmval;

// URI helper
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_uri_to_path(uri: string, callback: func): gmval;

// Saved Games
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_saved_games_show_saved_games_ui(title: string, button_add: bool, button_delete: bool, max_results: real, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_saved_games_commit_and_close([type_hint=`PlayServicesSavedGameCommitOptions`] options: gmval, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_saved_games_load(force_reload: bool, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_saved_games_open(name: string, create_if_not_found: bool, [type_hint=`PlayServicesSavedGamesConflictPolicy`] conflict_policy, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_saved_games_delete(name: string, callback: func): gmval;
[global, bind = typed_gml, type_hint=`PlayServicesError`]
function play_services_saved_games_resolve_conflict(conflict_id: string, use_local: bool, callback: func): gmval;

// Input class used by saved-game commit functions.
[global]
class `[[PlayServicesSavedGameCommitOptions]]` prototype Object
{
    [field] property name : string { get; set; }
    [field] property data : string { get; set; }
    [field] property desc : string { get; set; }
    [field] property played_time_millis : real { get; set; }
    [field] property progress_value : real { get; set; }
    [field] property cover_image_path : string { get; set; }
}

// Envelope for every callback below - carries only success/error. The actual
// payload always rides as further, separate positional arguments to
// callback.call(status, data...), never bundled into this struct or a
// bespoke per-function result class. See gmext-callback-design.
[global, bind = typed_gml]
class `[[PlayServicesResult]]` prototype Object
{
    [field] property success : bool { get; set; }
    [field] property error : string { get; set; }
}

// Data payloads for callback results. None of these carry success/error
// themselves - that's always the shared PlayServicesResult status argument -
// so none of these are Result-suffixed.
// All string fields here are Optional<T>, not a fake-empty-string fallback -
// a null string cannot be passed through a plain (non-Optional) string field's
// wire codec safely (writeString has no null-guard), and undefined is a real,
// distinct value from "" in GML.
[global, bind = typed_gml]
class `[[PlayServicesPlayerInfo]]` prototype Object
{
    [field, type_hint=`string?`] property player_id : gmval { get; set; }
    [field, type_hint=`string?`] property display_name : gmval { get; set; }
    [field, type_hint=`string?`] property title : gmval { get; set; }
    [field, type_hint=`string?`] property icon_image_uri : gmval { get; set; }
    [field, type_hint=`string?`] property hi_res_image_uri : gmval { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesPlayerStatsInfo]]` prototype Object
{
    [field] property average_session_length : real { get; set; }
    [field] property days_since_last_played : real { get; set; }
    [field] property number_of_purchases : real { get; set; }
    [field] property number_of_sessions : real { get; set; }
    [field] property session_percentile : real { get; set; }
    [field] property spend_percentile : real { get; set; }
    [field] property churn_probability : real { get; set; }
    [field] property high_spender_probability : real { get; set; }
    [field] property spend_probability : real { get; set; }
    [field] property total_spend_next_28_days : real { get; set; }
}

// revealed/unlocked image URIs are genuinely absent until the achievement
// reaches that state.
[global, bind = typed_gml]
class `[[PlayServicesAchievement]]` prototype Object
{
    [field, type_hint=`string?`] property achievement_id : gmval { get; set; }
    [field, type_hint=`string?`] property name : gmval { get; set; }
    [field, type_hint=`string?`] property description : gmval { get; set; }
    [field, type_hint=`PlayServicesAchievementState`] property state : gmval { get; set; }
    [field, type_hint=`PlayServicesAchievementType`] property type : gmval { get; set; }
    [field] property current_steps : real { get; set; }
    [field] property total_steps : real { get; set; }
    [field] property last_updated_timestamp : real { get; set; }
    [field] property xp_value : real { get; set; }
    [field, type_hint=`string?`] property revealed_image_uri : gmval { get; set; }
    [field, type_hint=`string?`] property unlocked_image_uri : gmval { get; set; }
}

// score_tag is documented as optional - a game may submit a score with no tag.
[global, bind = typed_gml]
class `[[PlayServicesScoreSubmission]]` prototype Object
{
    [field] property raw_score : real { get; set; }
    [field, type_hint=`string?`] property formatted_score : gmval { get; set; }
    [field, type_hint=`string?`] property score_tag : gmval { get; set; }
    [field] property new_best : bool { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesScoreReportInfo]]` prototype Object
{
    [field, type_hint=`PlayServicesScoreSubmission`] property daily : gmval { get; set; }
    [field, type_hint=`PlayServicesScoreSubmission`] property weekly : gmval { get; set; }
    [field, type_hint=`PlayServicesScoreSubmission`] property all_time : gmval { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesLeaderboardVariant]]` prototype Object
{
    [field, type_hint=`PlayServicesLeaderboardCollection`] property collection : gmval { get; set; }
    [field, type_hint=`PlayServicesLeaderboardTimeSpan`] property time_span : gmval { get; set; }
    [field] property has_player_info : bool { get; set; }
}

[global, bind = typed_gml]
class `[[PlayServicesLeaderboard]]` prototype Object
{
    [field, type_hint=`string?`] property leaderboard_id : gmval { get; set; }
    [field, type_hint=`string?`] property display_name : gmval { get; set; }
    [field, type_hint=`PlayServicesLeaderboardScoreOrder`] property score_order : gmval { get; set; }
    [field, type_hint=`PlayServicesLeaderboardVariant[]`] property variants : gmval { get; set; }
}

// score_holder is genuinely absent when the leaderboard variant doesn't include
// player info (see PlayServicesLeaderboardVariant.has_player_info). score_tag
// is documented as optional - a game may submit a score with no tag.
[global, bind = typed_gml]
class `[[PlayServicesLeaderboardScore]]` prototype Object
{
    [field, type_hint=`string?`] property display_rank : gmval { get; set; }
    [field, type_hint=`string?`] property display_score : gmval { get; set; }
    [field] property raw_score : real { get; set; }
    [field, type_hint=`string?`] property score_tag : gmval { get; set; }
    [field] property timestamp_millis : real { get; set; }
    [field, type_hint=`PlayServicesPlayerInfo?`] property score_holder : gmval { get; set; }
}

// cover_image_uri is genuinely absent when the game never set a cover image
// for this snapshot.
[global, bind = typed_gml]
class `[[PlayServicesSnapshotMetadata]]` prototype Object
{
    [field, type_hint=`string?`] property unique_name : gmval { get; set; }
    [field, type_hint=`string?`] property description : gmval { get; set; }
    [field, type_hint=`string?`] property device_name : gmval { get; set; }
    [field] property last_modified_timestamp : real { get; set; }
    [field] property played_time : real { get; set; }
    [field] property progress_value : real { get; set; }
    [field] property has_change_pending : bool { get; set; }
    [field, type_hint=`string?`] property cover_image_uri : gmval { get; set; }
}

// Fields below split into two mutually-exclusive groups gated by is_conflict:
// snapshot_metadata/data are present only when !is_conflict; conflict_id/
// snapshot_metadata_local/data_local/snapshot_metadata_remote/data_remote are
// present only when is_conflict. Optional<T>, not a fake-empty value, for the
// group that doesn't apply to a given result.
[global, bind = typed_gml]
class `[[PlayServicesSnapshotOpenInfo]]` prototype Object
{
    [field] property is_conflict : bool { get; set; }
    [field, type_hint=`PlayServicesSnapshotMetadata?`] property snapshot_metadata : gmval { get; set; }
    [field, type_hint=`string?`] property data : gmval { get; set; }
    [field, type_hint=`string?`] property conflict_id : gmval { get; set; }
    [field, type_hint=`PlayServicesSnapshotMetadata?`] property snapshot_metadata_local : gmval { get; set; }
    [field, type_hint=`string?`] property data_local : gmval { get; set; }
    [field, type_hint=`PlayServicesSnapshotMetadata?`] property snapshot_metadata_remote : gmval { get; set; }
    [field, type_hint=`string?`] property data_remote : gmval { get; set; }
}

// Enums
[global, bind = typed_gml]
enum PlayServicesAchievementState:int32 { Unlocked = 0, Revealed = 1, Hidden = 2, }
[global, bind = typed_gml]
enum PlayServicesAchievementType:int32 { Standard = 0, Incremental = 1, }
[global, bind = typed_gml]
enum PlayServicesLeaderboardTimeSpan:int32 { Daily = 0, Weekly = 1, AllTime = 2, }
[global, bind = typed_gml]
enum PlayServicesLeaderboardCollection:int32 { Public = 0, Friends = 3, }
[global, bind = typed_gml]
enum PlayServicesLeaderboardScoreOrder:int32 { SmallerIsBetter = 0, LargerIsBetter = 1, }
[global, bind = typed_gml]
enum PlayServicesSavedGamesConflictPolicy:int32 { Manual = -1, LongestPlaytime = 1, LastKnownGood = 2, MostRecentlyModified = 3, HighestProgress = 4, }
[global, bind = typed_gml]
enum PlayServicesSavedGamesUIResult:int32 { Cancelled = 0, Selected = 1, CreatedNew = 2, Error = -1, }

// Synchronous pre-flight return code - reported before the underlying GMS call
// is ever attempted. Ok means the call was accepted and the callback will fire
// once the real async result is known; anything else means the callback never
// fires at all for this invocation.
[global, bind = typed_gml]
enum PlayServicesError:int32 { Ok = 0, NotAuthenticated = -1, ActivityNull = -2, InvalidArgument = -3, }
